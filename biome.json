{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": ["apps/*/src/**/*.ts", "apps/*/src/**/*.tsx", "apps/*/scripts/**/*.mjs", "apps/*/*.ts", "apps/*/shared/**/*.ts", "apps/*/functions/**/*.ts", "apps/dl-worker/**/*.mjs", "packages/**/*.mjs"]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
