{
  "name": "msime-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @msime-web/site dev",
    "build": "pnpm --filter @msime-web/site build",
    "preview": "pnpm --filter @msime-web/site preview",
    "lint": "biome lint .",
    "test": "pnpm --recursive test",
    "test:seo": "pnpm --filter @msime-web/site test:seo",
    "test:seo:live": "pnpm --filter @msime-web/site test:seo:live"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4"
  }
}
